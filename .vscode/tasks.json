{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Java exercise",
            "type": "process",
            "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/.vscode/run-java.ps1",
                "-SourceFile",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
